# Verified by the author, 18 November 2026. Paths derive from the transferred layout.
tsr_config_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
export TSR_REVISION_ROOT=$(cd "$tsr_config_dir/.." && pwd -P)
export TSR_SOURCE_ROOT="$(cd "$TSR_REVISION_ROOT/../../.." && pwd -P)"
export TSR_OUTPUT_ROOT="$TSR_REVISION_ROOT/results"
export TSR_ACCOUNT='hbulut'
export TSR_QOS='normal'
export TSR_PARTITION='debug'
export TSR_GCC_MODULE='comp/gcc/14.1.0'
export TSR_R_MODULE='apps/R/4.5.2-gcc-14.1.0'
export TSR_R_LIB="$TSR_REVISION_ROOT/results/dependencies/R-4.5.2-gcc-14.1.0-linux/library"
# Resource requests are conservative starting values, not measured allocation limits.
export TSR_CPU_COUNT="${TSR_CPU_COUNT:-1}"
export TSR_MEMORY="${TSR_MEMORY:-2G}"
export TSR_WALLTIME="${TSR_WALLTIME:-01:00:00}"
export TSR_INSTALL_CPU_COUNT="${TSR_INSTALL_CPU_COUNT:-4}"
export TSR_INSTALL_MEMORY="${TSR_INSTALL_MEMORY:-8G}"
export TSR_INSTALL_WALLTIME="${TSR_INSTALL_WALLTIME:-02:00:00}"
export TSR_ARRAY_CONCURRENCY="${TSR_ARRAY_CONCURRENCY:-2}"
export TSR_ENV_VERIFIED=1
# Transfer acceptance is a hashed receipt, not an environment flag.
export TSR_FULL_APPROVED="${TSR_FULL_APPROVED:-}"
unset tsr_config_dir
